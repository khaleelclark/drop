# Loopback on host; Tailscale Serve is the HTTPS entry point.
HOUSEHOLD_ADDR=127.0.0.1:8787
HOUSEHOLD_DATA_DIR=./data
HOUSEHOLD_WEB_DIR=./web/dist
# Set to a strong, unique token before starting production mode.
HOUSEHOLD_TOKEN=
# Your exact HTTPS Tailscale Serve origin, without a trailing path.
HOUSEHOLD_PUBLIC_URL=
# Development only: permits no token if bound to loopback.
HOUSEHOLD_DEV=0
